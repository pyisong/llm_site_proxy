# 复制为 .env 后 docker compose 会自动加载（勿提交含密钥的 .env）

# Cursor Agent 认证（与本地一致）
CURSOR_API_KEY=

# 网关 Bearer（留空则不要求客户端 Authorization）
CURSOR_OPENAI_BRIDGE_API_KEY=

# 文生图引擎（网关 /v1/images/generations）：
# agent_interactive 调用 cursor agent 时不传 --mode（Ask 无法生图）；可选覆盖：
# CURSOR_BRIDGE_IMAGE_AGENT_MODE=   # 留空=默认可写 Agent；勿设为 ask
# sd_webui=转发 A1111 txt2img
# CURSOR_BRIDGE_IMAGE_ENGINE=agent
# Stable Diffusion WebUI 根地址（启用 sd_webui 时必填，且需在 WebUI 设置中开启 API）
# CURSOR_BRIDGE_SDWEBUI_URL=http://127.0.0.1:7860
# CURSOR_BRIDGE_SDWEBUI_NEGATIVE_PROMPT=
# CURSOR_BRIDGE_SDWEBUI_STEPS=28
# CURSOR_BRIDGE_SDWEBUI_CFG_SCALE=7
# CURSOR_BRIDGE_SDWEBUI_TIMEOUT=600

# 公园心流社区编辑插画（内置 preset park_flow_community）推荐：
# CURSOR_BRIDGE_IMAGE_ENGINE=sd_webui
# CURSOR_BRIDGE_SDWEBUI_URL=http://127.0.0.1:7860

# 客户端默认传给网关的 image_engine（可选；也可用 python3 client.py image --engine sd_webui）
# CURSOR_CLIENT_IMAGE_ENGINE=

# 映射端口
CURSOR_BRIDGE_PORT=8765

# 宿主机目录 → 容器 /workspace
CURSOR_BRIDGE_WORKSPACE=./workspace

# 每次 HTTP 请求使用 /workspace/jobs/<req_id> 隔离 agent 工作区（默认 1；0 关闭）
CURSOR_BRIDGE_ISOLATE_WORKSPACE=1

# 构建镜像时是否执行 curl 安装 Cursor CLI（0=跳过，适合离线构建后挂载二进制）
INSTALL_CURSOR=1

# 日志
CURSOR_BRIDGE_LOG_LEVEL=INFO
# 单条日志最大字符（默认 8192）；0=不截断
CURSOR_BRIDGE_LOG_MAX_CHARS=8192
CURSOR_BRIDGE_MODELS_CACHE_TTL=60
CURSOR_BRIDGE_LOG_AGENT_PROMPT=0
# agent 子进程监控（心跳 / 超时尾部 / 逐行 stderr）；agent_interactive 生图默认已启用同类日志
# CURSOR_BRIDGE_LOG_AGENT_SUBPROCESS=1   # 对所有 run_cursor_agent 开启
# CURSOR_BRIDGE_AGENT_PROGRESS_INTERVAL_SEC=30
# CURSOR_BRIDGE_AGENT_SUBPROCESS_LIVE_STDERR=1
# CURSOR_BRIDGE_AGENT_PIPE_READ_CHUNK=65536  # 监控模式读管道块大小，避免 readline 塞满管道死锁
# images/generations 响应日志里 base64 预览长度（默认 96）；=1 打完整（日志极大）
# CURSOR_BRIDGE_LOG_IMAGE_B64_PREVIEW=96
# CURSOR_BRIDGE_LOG_IMAGE_FULL=0
